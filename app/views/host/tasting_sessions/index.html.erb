<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div><span class="eyebrow">Hinter den Kulissen</span><h1>Dein Verkostungsbrett</h1></div>
  <%= link_to "+ Neue Verkostung", new_host_tasting_session_path, class: "btn btn-primary" %>
</div>
<div class="row g-4">
  <% @dashboard.tastings.each do |tasting| %>
    <div class="col-md-6"><article class="paper h-100">
      <span class="stamp"><%= tasting.status.humanize %></span>
      <h2 class="mt-3"><%= tasting.title %></h2>
      <p><%= l(tasting.date, format: "%d.%m.%Y") %> · <%= tasting.product_plural %></p>
      <%= link_to "Ans Pult →", host_tasting_session_path(tasting.invite_token), class: "btn btn-outline-dark" %>
    </article></div>
  <% end %>
  <% if @dashboard.tastings.empty? %><p>Noch nichts auf dem Brett. Zeit für die erste Runde.</p><% end %>
</div>
