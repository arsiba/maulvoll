<%= turbo_stream_from [@tasting, :host], id: "stream-#{@tasting.invite_token}-host", data: { turbo_permanent: true, controller: "live-connection" } %>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div><span class="stamp"><%= @tasting.status.humanize %></span><h1 class="mt-3"><%= @tasting.title %></h1></div>
  <%= link_to "TV öffnen ↗", tv_path(@tasting.tv_token), target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline-dark" %>
</div>
<section class="paper mb-4">
  <h2>Dein Abend. Dein Tempo.</h2>
  <p><%= @view[:count] %> Gäste · <%= @view[:voted] %> Stimmen in der aktuellen Runde</p>
  <div class="d-flex flex-wrap gap-3">
    <% unless @tasting.final_reveal? %>
      <%= button_to({ "lobby" => "Erste Runde starten →", "voting" => "Abstimmung beenden →", "round_vibe" => "Weiter zur nächsten Phase →" }.fetch(@tasting.status), advance_host_tasting_session_path(@tasting.invite_token), params: { version: @tasting.updated_at.iso8601(6) }, class: "btn btn-primary", data: { turbo_confirm: "Phase wirklich weiterschalten?" }) %>
    <% end %>
    <%= button_to(@tasting.entry_locked? ? "Lobby öffnen" : "Lobby schließen", lock_host_tasting_session_path(@tasting.invite_token), method: :patch, class: "btn btn-outline-dark") %>
  </div>
  <p class="mt-4 small">Teilnehmer-Link: <%= link_to join_url(@tasting.invite_token), join_path(@tasting.invite_token) %></p>
</section>
<div class="row g-4">
  <section class="col-lg-8"><div class="paper">
    <h2>Die geheimen Kandidaten</h2>
    <p class="small">Diese Marken sind nur hier sichtbar. Runden lassen sich bis zum Start bearbeiten.</p>
    <% @tasting.rounds.each do |round| %>
      <article class="round-editor">
        <% if @tasting.lobby? %>
          <%= form_with scope: :round, url: host_tasting_session_round_path(@tasting.invite_token, round.number), method: :patch do |form| %>
            <%= render "host/rounds/fields", form: form, round: round %>
            <%= form.submit "Speichern", class: "btn btn-sm btn-outline-dark mt-3" %>
          <% end %>
          <%= button_to "Runde entfernen", host_tasting_session_round_path(@tasting.invite_token, round.number), method: :delete, class: "btn btn-sm btn-outline-danger mt-3", data: { turbo_confirm: "Runde entfernen?" } %>
        <% else %>
          <h3>Nr. <%= round.number %> · <%= round.secret_identity %></h3><p><%= round.context_info %></p>
        <% end %>
      </article>
    <% end %>
    <% if @tasting.lobby? %>
      <h3>Neue Runde</h3>
      <%= form_with scope: :round, url: host_tasting_session_rounds_path(@tasting.invite_token) do |form| %>
        <%= render "host/rounds/fields", form: form, round: nil %>
        <%= form.submit "+ Runde anlegen", class: "btn btn-primary mt-3" %>
      <% end %>
    <% end %>
  </div></section>
  <section class="col-lg-4"><div class="paper">
    <h2>Die Runde am Tisch</h2>
    <% @view[:participants].each do |participant| %>
      <div class="participant-row"><span><%= participant.name %></span><%= button_to "Blockieren", host_tasting_session_participant_path(@tasting.invite_token, participant.session_token), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Teilnehmer blockieren und Stimmen aus der Auswertung nehmen?" } %></div>
    <% end %>
    <% if @view[:participants].empty? %><p>Die Stühle sind noch leer.</p><% end %>
  </div></section>
</div>
