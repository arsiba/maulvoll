<div class="table-responsive"><table class="table comparison"><caption>Deine Bewertungen und der Gruppendurchschnitt</caption>
  <thead><tr><th scope="col">Nr.</th><th scope="col">Name / Marke</th><th scope="col">Zubereitung / Info</th><% view[:tasting].criteria_schema.each do |criterion| %><th scope="col"><%= criterion.fetch("label") %></th><% end %><th scope="col">Gesamt / <%= view[:tasting].max_total %><br>Du / Ø Gruppe</th><th scope="col">Sonst noch was?</th></tr></thead>
  <tbody><% view[:ranking].sort_by { |entry| entry[:round].number }.each do |entry| %><% round = entry[:round] %><% personal = view[:personal_ratings][round.id] %><tr><th scope="row"><%= round.number %></th><td><%= round.secret_identity %></td><td><%= round.context_info %></td><% view[:tasting].criteria_schema.each do |criterion| %><td><%= personal&.scores&.fetch(criterion.fetch("key"), nil) || "–" %></td><% end %><td><%= personal&.total_score || "–" %> / <%= score(entry[:average_total]) %></td><td><%= personal&.notes %></td></tr><% end %></tbody>
</table></div>
