<section class="paper narrow">
  <span class="stamp">Ein Platz ist für dich frei</span>
  <h1><%= @tasting.title %></h1>
  <p>Keine Ahnung, was drin ist? Perfekt. Dein Geschmack hat das letzte Wort.</p>
  <%= form_with url: join_path(@tasting.invite_token) do |form| %>
    <%= invisible_captcha :nickname_confirmation, nil, nonce: true %>
    <div class="mb-4"><%= form.label :name, "Wie heißt du am Tisch?", class: "form-label" %><%= form.text_field :name, maxlength: 25, autocomplete: "off", class: "form-control", placeholder: "Dein Name", aria: { describedby: "name-help" } %><p id="name-help" class="small mt-2">Maximal 25 Zeichen. Dein Name erscheint auf dem TV. Beim Wiederbeitritt kannst du das Feld leer lassen.</p></div>
    <% if @tasting.entry_locked? %><p class="notice">Die Lobby ist geschlossen. Bereits angemeldete Gäste können wieder einsteigen.</p><% end %>
    <%= form.submit "Bin dabei / Wieder einsteigen →", class: "btn btn-primary w-100" %>
  <% end %>
</section>
