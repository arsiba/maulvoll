<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "Maulvoll · Blind rein. Ehrlich raus." %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>
    <%= yield :head %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt</a>
    <header class="site-header no-print">
      <%= link_to "MAULVOLL", root_path, class: "wordmark" %>
      <span class="small">Blind rein. Ehrlich raus.</span>
      <% if authenticated? %>
        <%= link_to "Host-Pult", host_tasting_sessions_path %>
        <%= button_to "Abmelden", session_path, method: :delete, class: "btn btn-sm btn-outline-dark" %>
      <% end %>
    </header>
    <main id="main" class="container py-4">
      <% flash.each do |type, message| %>
        <div class="notice" role="status"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="container py-4 no-print small">Geschmack ist Ansichtssache. Deine Stimme zählt.</footer>
  </body>
</html>
